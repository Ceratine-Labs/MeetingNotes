APP_NAME=NoteFiend
# The backup archive folder is deliberately NOT keyed off APP_NAME — renaming
# the product would otherwise orphan every existing backup. Leave this alone
# unless you are also moving the archives.
BACKUP_ARCHIVE_NAME=MeetingNotes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# ---------------------------------------------------------------------------
# Back office (SaaS admin)
# ---------------------------------------------------------------------------
# Details for the first back-office account, created by the seed master.
# Leave ADMIN_SEED_PASSWORD unset and the seeder generates one and prints it
# ONCE — there is deliberately no hardcoded default. You can also skip the
# seeder entirely and use: php artisan admin:create
ADMIN_SEED_NAME="Ryan Cruickshank"
ADMIN_SEED_EMAIL=ryan@ceratine-labs.co.za
ADMIN_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Billing (Paystack)
# ---------------------------------------------------------------------------
# With BILLING_ENABLED=false the product runs entirely on the free plan:
# registration, generation and every screen work, and the upgrade paths are
# hidden rather than broken. Set it true only once the keys below are real.
#
# These are read from the environment ONLY — unlike the LLM keys, they are not
# admin-editable settings, so a back-office compromise cannot redirect payments.
BILLING_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
BILLING_CURRENCY=ZAR
# Days a subscription keeps working after a failed renewal before dropping to
# the free plan. Nothing is ever deleted on downgrade.
BILLING_GRACE_PERIOD_DAYS=7
# Warn in the UI when this fraction of the generation allowance remains.
BILLING_QUOTA_WARNING_THRESHOLD=0.2

# ---------------------------------------------------------------------------
# Tenancy (organisation workspaces)
# ---------------------------------------------------------------------------
# Meeting dates and times in generated minutes render in the workspace's zone,
# so a wrong default produces wrong documents, not just an odd clock.
TENANCY_DEFAULT_TIMEZONE=Africa/Johannesburg
TENANCY_INVITATION_EXPIRY_DAYS=14
# Abuse limit, not a commercial one — stops one account spinning up thousands
# of free-tier workspaces to farm free generations.
TENANCY_MAX_ORGANISATIONS_PER_USER=5

# ---------------------------------------------------------------------------
# Public site / legal pages
# ---------------------------------------------------------------------------
# POPIA requires a reachable information officer, so a placeholder address here
# is a compliance gap rather than a cosmetic one.
SITE_CONTACT_EMAIL=info@notefiend.com
SITE_SUPPORT_EMAIL=support@notefiend.com
SITE_COMPANY_NAME="Ceratine Labs"
SITE_COMPANY_COUNTRY="South Africa"
# Bump whenever the terms or privacy wording changes materially.
SITE_LEGAL_EFFECTIVE_DATE=2026-07-30
# Stated in the privacy policy — changing it changes a published commitment.
SITE_DATA_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------
# Milliseconds the navbar search box waits after the LAST keystroke before it
# queries. The timer resets on every keystroke, so a continuous typist triggers
# exactly one request. Deliberately long — each request runs a full-text query
# across the workspace.
SEARCH_DEBOUNCE_MS=1500
